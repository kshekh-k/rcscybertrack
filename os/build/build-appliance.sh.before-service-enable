#!/usr/bin/env bash
# RCS CyberTrack — Bootable Appliance ISO Builder
# Generates a reproducible appliance rootfs and ISO image artifact.

set -euo pipefail

# Define text formatting
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ROOTFS_DIR="${BASE_DIR}/os/image/rootfs"
OUTPUT_DIR="${BASE_DIR}/os/image/output"
ISO_PATH="${OUTPUT_DIR}/rcscybertrack-v0.6.1-amd64.iso"

echo -e "${BLUE}=== RCS CyberTrack Appliance ISO Builder ===${NC}"
echo -e "[*] Base Directory: ${BASE_DIR}"

# 1. Clean previous rootfs & output directories
echo -e "\n[*] Preparing clean staging directories..."
rm -rf "${ROOTFS_DIR}"
mkdir -p "${ROOTFS_DIR}/usr/share/rcscybertrack"
mkdir -p "${ROOTFS_DIR}/etc/rcscybertrack"
mkdir -p "${ROOTFS_DIR}/etc/systemd/system"
mkdir -p "${ROOTFS_DIR}/var/log/rcscybertrack"
mkdir -p "${ROOTFS_DIR}/boot/grub"
mkdir -p "${OUTPUT_DIR}"

# 2. Copy Application Core & Modules
echo -e "\n[*] Copying application components to /usr/share/rcscybertrack..."
cp -r "${BASE_DIR}/management" "${ROOTFS_DIR}/usr/share/rcscybertrack/"
cp -r "${BASE_DIR}/firewall" "${ROOTFS_DIR}/usr/share/rcscybertrack/"
cp -r "${BASE_DIR}/network" "${ROOTFS_DIR}/usr/share/rcscybertrack/"
mkdir -p "${ROOTFS_DIR}/usr/share/rcscybertrack/os"
cp -r "${BASE_DIR}/os/config" "${BASE_DIR}/os/services" "${BASE_DIR}/os/scripts" "${BASE_DIR}/os/build" "${ROOTFS_DIR}/usr/share/rcscybertrack/os/"

if [ -d "${BASE_DIR}/gui/dist" ]; then
    mkdir -p "${ROOTFS_DIR}/usr/share/rcscybertrack/gui"
    cp -r "${BASE_DIR}/gui/dist" "${ROOTFS_DIR}/usr/share/rcscybertrack/gui/dist"
fi

if [ -d "${BASE_DIR}/.venv" ]; then
    echo -e "    Bundling Python runtime environment..."
    cp -r "${BASE_DIR}/.venv" "${ROOTFS_DIR}/usr/share/rcscybertrack/.venv"
fi

# 3. Copy Configuration and Service Files
echo -e "\n[*] Installing systemd service unit and configuration..."
cp "${BASE_DIR}/os/config/rcscybertrack.yaml" "${ROOTFS_DIR}/etc/rcscybertrack/rcscybertrack.yaml"
cp "${BASE_DIR}/os/services/rcscybertrack-core.service" "${ROOTFS_DIR}/etc/systemd/system/rcscybertrack-core.service"

# 4. Create OS Release Metadata
cat <<EOF > "${ROOTFS_DIR}/etc/os-release"
NAME="RCS CyberTrack Security Appliance"
VERSION="v0.6.1"
ID=rcscybertrack
PRETTY_NAME="RCS CyberTrack Security Appliance v0.6.1 (x86_64)"
VERSION_ID="0.6.1"
HOME_URL="https://console.rcscybertrack.in"
EOF

# 5. Build GRUB Bootloader Configuration
cat <<EOF > "${ROOTFS_DIR}/boot/grub/grub.cfg"
set default=0
set timeout=5

menuentry "RCS CyberTrack Security Appliance v0.6.1" {
    linux /boot/vmlinuz quiet console=tty0 console=ttyS0,115200
    initrd /boot/initrd.img
}
EOF

# 6. Execute Python ISO Generator
echo -e "\n[*] Compiling ISO artifact via PyCdlib..."
"${BASE_DIR}/.venv/bin/python" "${BASE_DIR}/os/image/config/make_iso.py" "${ROOTFS_DIR}" "${ISO_PATH}"

# 7. Validate Artifact
echo -e "\n[*] Validating ISO artifact..."
if [ -f "${ISO_PATH}" ]; then
    FILE_INFO=$(file "${ISO_PATH}")
    echo -e "    File Type: ${GREEN}${FILE_INFO}${NC}"
    echo -e "\n${GREEN}=== ISO BUILD SUCCESSFUL ===${NC}"
else
    echo -e "${RED}Error: ISO generation failed.${NC}" >&2
    exit 1
fi
