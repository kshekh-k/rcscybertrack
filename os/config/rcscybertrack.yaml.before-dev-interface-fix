system:
  hostname: rcscybertrack-appliance
  timezone: UTC
  log_level: INFO

management:
  api:
    enabled: true
    host: 127.0.0.1
    port: 8000

firewall:
  enabled: true
  backend: nftables
  nat:
    enabled: true
    forwarding_enabled: true
    wan_interface: eth0
    lan_interface: eth1
    lan_subnet: 192.168.2.0/24

network:
  interfaces:
    enabled: true
  routing:
    enabled: true
  dhcp:
    enabled: true
  dns:
    enabled: true

captive_portal:
  enabled: false
  interface: eth1
  subnet: 192.168.2.0/24
  listen_host: 192.168.2.1
  listen_port: 8080
  session_timeout_minutes: 60

vpn:
  enabled: false

sdwan:
  enabled: false

security:
  authentication:
    token_expire_minutes: 60
    secret_key: "change-this-in-production-use-env-var-in-prod"
  audit:
    log_path: "os/config/audit.log"
