# RCS CyberTrack Appliance Environment Template
# Copy this file to .env and change all secrets before deploying to production.

# --- Environment Mode ---
# Options: development, production
CYBERTRACK_ENV=production

# --- Database Configuration ---
CYBERTRACK_DATABASE_URL=sqlite:///./data/cybertrack.db
# PostgreSQL Example: postgresql+psycopg2://user:password@localhost:5432/cybertrack

# --- JWT Cryptographic Security ---
# Mandatory in production. Generate a strong key e.g. `openssl rand -hex 32`
CYBERTRACK_JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
CYBERTRACK_TOKEN_EXPIRE_MINUTES=60

# --- Server & Service Settings ---
CYBERTRACK_HOST=127.0.0.1
CYBERTRACK_PORT=8000
CYBERTRACK_LOG_LEVEL=INFO
CYBERTRACK_FIREWALL_BACKEND=nftables
CYBERTRACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Bootstrap Administrative Account Credentials ---
# In production, bootstrap is disabled by default (CYBERTRACK_BOOTSTRAP_ENABLED=false).
# If set to true for initial provisioning, strong passwords must be provided.
CYBERTRACK_BOOTSTRAP_ENABLED=false
CYBERTRACK_BOOTSTRAP_ADMIN_USERNAME=admin
CYBERTRACK_BOOTSTRAP_ADMIN_PASSWORD=your-secure-admin-password-here

CYBERTRACK_BOOTSTRAP_OPERATOR_USERNAME=operator
CYBERTRACK_BOOTSTRAP_OPERATOR_PASSWORD=your-secure-operator-password-here

CYBERTRACK_BOOTSTRAP_AUDITOR_USERNAME=auditor
CYBERTRACK_BOOTSTRAP_AUDITOR_PASSWORD=your-secure-auditor-password-here

CYBERTRACK_BOOTSTRAP_VIEWER_USERNAME=viewer
CYBERTRACK_BOOTSTRAP_VIEWER_PASSWORD=your-secure-viewer-password-here

# --- Password Policy & Account Lockout Configuration ---
CYBERTRACK_MIN_PASSWORD_LENGTH=8
CYBERTRACK_MAX_FAILED_LOGIN_ATTEMPTS=5
CYBERTRACK_LOCKOUT_DURATION_MINUTES=15
